# URL canonica do site (Cloudflare Pages / dominio cliente)
PUBLIC_SITE_URL=https://exemplo.com.br

# Feed XML do CRM (prebuild: scripts/fetch-listings.mjs)
# Sem esta var, o build cai no mock public/data/listings-mock.xml
LISTINGS_FEED_URL=https://app.sarmy.com.br/api/crm/public/site/<FEED_TOKEN>/listings.xml

# P4 Captacao (opcional — fora do escopo v1)
# PUBLIC_SUPABASE_URL=
# PUBLIC_SUPABASE_ANON_KEY=
# PUBLIC_GA4_ID=
# PUBLIC_META_PIXEL_ID=

# Web3Forms — access key pública (destino: contato@tetesantos.com.br)
# Gerar em https://web3forms.com. Necessária para o pop-up de lead.
# PUBLIC_WEB3FORMS_ACCESS_KEY=

# GTM: container GTM-MT4VG7GP via Stape em https://v1.tetesantos.com.br (hardcoded no Tracking).
# Pixel Meta é configurado pela agência dentro do GTM — não hardcodar no site.
