---
import { site } from '../../config/site';
import { assetPath, sitePath } from '../../lib/paths';

interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  eyebrow = site.taglineSecondary,
  title = site.tagline,
  subtitle = 'Consultoria imobiliária de alto luxo com estratégia, discrição e curadoria de patrimônio.',
  ctaLabel = 'Agende sua visita',
  ctaHref = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.message)}`,
} = Astro.props;

/** Rotação home: H8 + H17 edited + H18 dia. Header desktop opaco. */
const slides = [
  {
    base: '/images/hero/tete-H8-hero-consultoria-bordo',
    baseMobile: '/images/hero/tete-H8-hero-consultoria-bordo-mobile',
    alt: 'Tetê Santos em consultoria, casaco bordô, living de alto padrão',
    altMobile: 'Tetê Santos em consultoria, casaco bordô — versão vertical',
  },
  {
    base: '/images/hero/tete-H17-hero-aerea-drone',
    baseMobile: '/images/hero/tete-H17-hero-aerea-drone-mobile',
    alt: 'Vista aérea de residência de alto padrão em Belo Horizonte',
    altMobile: 'Vista aérea de residência de alto padrão — versão vertical',
  },
  {
    base: '/images/hero/tete-H18-hero-sala-vista',
    baseMobile: '/images/hero/tete-H18-hero-sala-vista-mobile',
    alt: 'Sala de estar de alto luxo com vista panorâmica à luz do dia',
    altMobile: 'Sala de estar de alto luxo com vista panorâmica — versão vertical',
  },
].map((slide) => ({
  ...slide,
  webp: assetPath(`${slide.base}.webp`),
  webp1280: assetPath(`${slide.base}-1280.webp`),
  avif: assetPath(`${slide.base}.avif`),
  avif1280: assetPath(`${slide.base}-1280.avif`),
  webpMobile: assetPath(`${slide.baseMobile}.webp`),
  webp768Mobile: assetPath(`${slide.baseMobile}-768.webp`),
  avifMobile: assetPath(`${slide.baseMobile}.avif`),
  avif768Mobile: assetPath(`${slide.baseMobile}-768.avif`),
}));

const first = slides[0];
const deferredSlides = slides.slice(1);
---

<section class="hero" data-hero-slideshow aria-label="Apresentacao principal">
  <div class="hero__slides" data-hero-slides>
    <div class="hero__slide hero__slide--1 hero__slide--active" data-hero-slide>
      <picture>
        <source
          media="(max-width: 767px)"
          type="image/avif"
          srcset={`${first.avif768Mobile} 768w, ${first.avifMobile} 1080w`}
          sizes="100vw"
        />
        <source
          media="(max-width: 767px)"
          type="image/webp"
          srcset={`${first.webp768Mobile} 768w, ${first.webpMobile} 1080w`}
          sizes="100vw"
        />
        <source
          type="image/avif"
          srcset={`${first.avif1280} 1280w, ${first.avif} 1920w`}
          sizes="100vw"
        />
        <source
          type="image/webp"
          srcset={`${first.webp1280} 1280w, ${first.webp} 1920w`}
          sizes="100vw"
        />
        <img
          src={first.webp}
          alt={first.alt}
          width="1920"
          height="1080"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </div>
  </div>
  <script
    type="application/json"
    data-hero-deferred
    set:html={JSON.stringify({ slides: deferredSlides })}
  />
  <div class="hero__overlay"></div>
  <div class="hero__content">
    <p class="eyebrow hero__eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="hero__subtitle">{subtitle}</p>
    <div class="hero__actions">
      <a class="btn btn-accent btn-motion" href={ctaHref} target="_blank" rel="noopener noreferrer">
        {ctaLabel}
      </a>
      <a class="btn btn-secondary btn-motion" href={`${sitePath('/imoveis')}#filtros`}>Busca avançada com filtros</a>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector('[data-hero-slideshow]');
  const slidesRoot = root?.querySelector('[data-hero-slides]');
  const deferredNode = root?.querySelector('[data-hero-deferred]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function buildSlide(slide, index) {
    const el = document.createElement('div');
    el.className = `hero__slide hero__slide--${index + 1}`;
    el.setAttribute('data-hero-slide', '');
    const picture = document.createElement('picture');
    const sources = [
      ['(max-width: 767px)', 'image/avif', `${slide.avif768Mobile} 768w, ${slide.avifMobile} 1080w`],
      ['(max-width: 767px)', 'image/webp', `${slide.webp768Mobile} 768w, ${slide.webpMobile} 1080w`],
      [null, 'image/avif', `${slide.avif1280} 1280w, ${slide.avif} 1920w`],
      [null, 'image/webp', `${slide.webp1280} 1280w, ${slide.webp} 1920w`],
    ];
    for (const [media, type, srcset] of sources) {
      const source = document.createElement('source');
      if (media) source.media = media;
      source.type = type;
      source.srcset = srcset;
      source.sizes = '100vw';
      picture.appendChild(source);
    }
    const img = document.createElement('img');
    img.src = slide.webp;
    img.alt = slide.alt;
    img.width = 1920;
    img.height = 1080;
    img.loading = 'lazy';
    img.decoding = 'async';
    picture.appendChild(img);
    el.appendChild(picture);
    return el;
  }

  function startRotation() {
    const slideNodes = root ? [...root.querySelectorAll('[data-hero-slide]')] : [];
    if (!root || slideNodes.length < 2 || reduced) return;
    let current = 0;
    window.setInterval(() => {
      slideNodes[current]?.classList.remove('hero__slide--active');
      current = (current + 1) % slideNodes.length;
      slideNodes[current]?.classList.add('hero__slide--active');
    }, 6000);
  }

  function injectDeferred() {
    if (!slidesRoot || !deferredNode || reduced) return;
    try {
      const payload = JSON.parse(deferredNode.textContent || '{}');
      const deferred = Array.isArray(payload.slides) ? payload.slides : [];
      if (!deferred.length) return;
      deferred.forEach((slide, i) => {
        slidesRoot.appendChild(buildSlide(slide, i + 1));
      });
      deferredNode.remove();
      startRotation();
    } catch {
      // slideshow fica só no primeiro slide
    }
  }

  if (root && slidesRoot && deferredNode && !reduced) {
    const run = () => injectDeferred();
    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(run, { timeout: 2500 });
    } else {
      window.setTimeout(run, 1200);
    }
  }
</script>

<style is:global>
  .hero {
    position: relative;
    /* Mobile: ~92vh; desktop: faixa preenche viewport (compensa overlay -header). */
    min-height: min(92vh, 920px);
    display: grid;
    align-items: end;
    overflow: hidden;
    color: var(--color-background);
    padding-top: var(--header-height);
    /* Bordô sob o header (overlay transparente no mobile / opaco no desktop). */
    background: var(--color-primary);
  }

  .hero__slides {
    position: absolute;
    inset: 0;
    /* page-overlay puxa hero em -header; 2× alinha o topo da foto à base do menu. */
    top: calc(var(--header-height) * 2);
    overflow: hidden;
  }

  @media (min-width: 961px) {
    .hero {
      min-height: min(calc(100vh + var(--header-height)), 1168px);
    }
  }

  .hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity var(--motion-hero-fade) var(--ease-hero);
  }

  .hero__slide--active {
    opacity: 1;
    z-index: 1;
  }

  .hero__slide picture,
  .hero__slide img {
    width: 100%;
    height: 100%;
    display: block;
  }

  .hero__slide img {
    object-fit: cover;
    object-position: center 18%;
    transform: scale(1);
    transform-origin: center 20%;
    animation: heroKenBurns var(--motion-hero) var(--ease-hero) infinite alternate;
  }

  /* H8 desktop/tablet: face à direita + headroom (sem zoom oversized). */
  @media (min-width: 768px) {
    .hero__slide--1 img {
      object-position: 70% 28%;
      transform-origin: 70% 24%;
      animation-name: heroKenBurnsH8;
    }
  }

  @media (max-width: 767px) {
    .hero {
      min-height: min(88vh, 820px);
    }

    .hero__slide img {
      object-position: center 18%;
      transform-origin: center 20%;
    }

    /* H8 mobile: prioriza cabeça/rosto no topo-direita do quadro. */
    .hero__slide--1 img {
      object-position: 62% 0%;
      transform-origin: 62% 8%;
      animation: none;
      transform: scale(1);
    }
  }

  @keyframes heroKenBurnsH8 {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.03);
    }
  }

  /* H17: aérea — casa no meio do quadro */
  .hero__slide--2 img {
    object-position: center 42%;
    transform-origin: center 40%;
  }

  /* H18: sala com vista — focal no sofá/tapete/vidraça (não no teto). */
  .hero__slide--3 img {
    object-position: center 78%;
    transform-origin: center 72%;
  }

  .hero__slide:not(.hero__slide--active) img {
    animation: none;
    transform: scale(1);
  }

  @keyframes heroKenBurns {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.03);
    }
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(62 25 35 / 0.12) 0%, rgb(62 25 35 / 0.05) 28%, rgb(62 25 35 / 0.55) 100%),
      linear-gradient(90deg, rgb(36 26 27 / 0.42) 0%, rgb(36 26 27 / 0.18) 28%, transparent 42%);
    z-index: 2;
  }

  .hero__content {
    position: relative;
    z-index: 3;
    padding-block: var(--space-10) var(--space-12);
    /* Não centrar: .container + max-width estreito colocava a copy em cima do rosto. */
    width: min(760px, 100% - var(--space-4));
    max-width: 760px;
    margin-left: max(calc(var(--space-4) / 2), calc((100% - 1180px) / 2));
    margin-right: auto;
  }

  @media (min-width: 768px) {
    .hero__content {
      width: min(34rem, 40vw);
      max-width: min(34rem, 40vw);
    }
  }

  .hero__eyebrow {
    /* Latão some no hero claro (H17/H18); osso mantém paleta e AA. */
    color: var(--color-background);
    text-shadow: 0 1px 2px rgb(36 26 27 / 0.45);
    line-height: 1.2;
    letter-spacing: 0.18em;
    margin: 0 0 var(--space-2);
  }

  .hero h1 {
    font-size: clamp(36px, 5.2vw, 64px);
    margin-bottom: var(--space-3);
    text-wrap: balance;
  }

  .hero__subtitle {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    max-width: 42ch;
    color: color-mix(in srgb, var(--color-background) 88%, transparent);
    margin-bottom: var(--space-4);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__slide {
      transition: none;
    }

    .hero__slide:not(:first-child) {
      display: none;
    }

    .hero__slide img {
      animation: none;
    }
  }
</style>
