---
/** Companion noscript do GTM (Stape). Inserir no início do <body>. */
const GTM_ID = 'GTM-MT4VG7GP';
const src = `https://v1.tetesantos.com.br/ns.html?id=${GTM_ID}`;
---

<!-- Google Tag Manager (noscript) -->
<noscript>
  <iframe
    src={src}
    height="0"
    width="0"
    style="display:none;visibility:hidden"
    title="Google Tag Manager"></iframe>
</noscript>
<!-- End Google Tag Manager (noscript) -->
