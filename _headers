# Cloudflare Pages — cabeçalhos de resposta (ignorado no preview do GitHub Pages).
# Regras que casam com a mesma URL são somadas; por isso Cache-Control só aparece
# nas regras específicas, nunca em /*.

/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Arquivos com hash no nome (CSS, JS, fontes): o conteúdo nunca muda para a mesma URL.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Sem hash no nome: trocar uma imagem exige nome novo (ex.: sufixo -v2), senão o
# visitante recorrente vê a versão antiga por até 30 dias.
/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/logo/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/videos/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/favicon.svg
  Cache-Control: public, max-age=604800
